# auto-dj-orchestrator configuration.
# Copy to .env and fill in. All values validated by src/config.ts at boot.
#
# ── PROVISIONING PREREQUISITES ─────────────────────────────────────────────
# Before this service can run, the following must be in place:
#
# 1. Auto-DJ service account (Backend-Service):
#    A Better-Auth user with the `dj` org-member role — NOT stationManager/
#    admin/owner. Self-signup is disabled; the account is self-provisioned by
#    Backend-Service's idempotent startup bootstrap (createAutoDjUser), gated
#    by CREATE_AUTO_DJ_USER + AUTO_DJ_* env on the BS side.
#    The account's djName (public handle) is "Auto DJ"; PII fields are empty.
#
# 2. Trusted origin (Backend-Service):
#    AUTH_TRUSTED_ORIGIN (below) must appear in Backend-Service's
#    BETTER_AUTH_TRUSTED_ORIGINS, or sign-in calls are rejected.
#
# 3. AzuraCast station shortcode:
#    AZURACAST_STATION_SHORTCODE must match the live station. Verify with:
#      curl https://remote.wxyc.org/api/nowplaying/{shortcode}
#    A single station object back = correct. An array back = wrong shortcode.
#    A wrong shortcode silently degrades to HTTP-only (no Centrifugo push).
#
# See README.md § "Provisioning prerequisites" for the full checklist.

# ── HTTP / WS server ───────────────────────────────────────────────────────
ORCHESTRATOR_PORT=8090
ORCHESTRATOR_PUBLIC_URL=http://localhost:8090
LOG_LEVEL=info
# Comma-separated origins allowed to call the virtual-switch API from a browser (dj-site).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# SENTRY_DSN=                       # optional; observability is a no-op if unset

# ── Arduino-facing management channel ──────────────────────────────────────
AUTO_DJ_KEY=changeme                # X-Auto-DJ-Key shared secret (WS upgrade + HTTP fallback)
DEVICE_OFFLINE_THRESHOLD_MS=60000   # heartbeat older than this => device offline
WS_PING_INTERVAL_MS=15000           # server->device ws ping cadence (dead if no pong in 10s)

# ── AzuraCast now-playing source ───────────────────────────────────────────
AZURACAST_WS_URL=wss://remote.wxyc.org/api/live/nowplaying/websocket
AZURACAST_HTTP_URL=https://remote.wxyc.org/api/nowplaying_static/main.json
# The Centrifugo channel is station:<shortcode>. Verify against live AzuraCast
# before deploying to prod (GET /api/nowplaying/<shortcode> must return data).
# NB the station is NAMED "wxyc" but its shortcode is "main" (verified against
# the live station; see #33).
AZURACAST_STATION_SHORTCODE=main
AZURACAST_SAFETY_POLL_MS=60000      # safety-net HTTP poll cadence while the WS is connected
AZURACAST_FALLBACK_POLL_MS=20000    # HTTP poll cadence when the WS is unavailable

# ── Backend-Service (single flowsheet backend; mirrors to tubafrenzy) ───────
BACKEND_SERVICE_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8082/auth
# Sent as Origin: on auth calls. Must be listed in Backend-Service's
# BETTER_AUTH_TRUSTED_ORIGINS or sign-in will be rejected (403).
AUTH_TRUSTED_ORIGIN=http://localhost:8090
# Service account credentials. The account must already exist in BS with the
# `dj` org-member role (see provisioning prerequisites above).
# SECURITY: Do NOT commit real passwords. Store AUTO_DJ_PASSWORD as a
# per-environment deploy secret, distinct between staging and prod.
AUTO_DJ_EMAIL=auto-dj@wxyc.org
AUTO_DJ_PASSWORD=changeme
AUTO_DJ_SHOW_NAME=Auto DJ
TOKEN_REFRESH_SKEW_MS=60000         # refresh the JWT this long before it expires

# ── dj-site JWT verification (mirror the Backend-Service auth env) ──────────
BETTER_AUTH_JWKS_URL=http://localhost:8082/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:8082
BETTER_AUTH_AUDIENCE=http://localhost:8082

# ── Restart recovery ───────────────────────────────────────────────────────
STATE_STORE_PATH=./auto-dj-state.json
